# Copie para deploy/.env e preencha. Este arquivo guarda segredos:
#
#   cp deploy/env.example deploy/.env
#   chmod 600 deploy/.env
#
# deploy/.env está no .gitignore — confira antes de commitar qualquer coisa.

# ── Django ────────────────────────────────────────────────────────────────────

# Gere uma nova, não reaproveite a do Render:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave

DJANGO_SETTINGS_MODULE=helpy.settings.prod
DEBUG=False

# Domínio pelo qual o app é servido. Liste explicitamente — '*' aceita qualquer
# Host e abre a porta para cache poisoning e links forjados.
ALLOWED_HOSTS=helpy.seudominio.com
CSRF_TRUSTED_ORIGINS=https://helpy.seudominio.com

# 1 ano. Só suba para cá depois de confirmar que o HTTPS está firme: o navegador
# guarda o prazo e não há como voltar atrás antes de ele expirar.
SECURE_HSTS_SECONDS=3600

# ── Banco de dados ────────────────────────────────────────────────────────────
# `db` é o nome do serviço no compose; dentro da rede do Docker ele resolve.

POSTGRES_DB=helpy
POSTGRES_USER=helpy
POSTGRES_PASSWORD=troque-esta-senha

DATABASE_URL=postgresql://helpy:troque-esta-senha@db:5432/helpy

# ── Túnel da Cloudflare ───────────────────────────────────────────────────────
# Token gerado ao criar o túnel em Zero Trust → Networks → Tunnels.

TUNNEL_TOKEN=

# ── Monitoramento (opcional) ──────────────────────────────────────────────────

SENTRY_DSN=
SENTRY_ENVIRONMENT=producao
SENTRY_TRACES_SAMPLE_RATE=0.0
